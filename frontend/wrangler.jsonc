{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiz-app-frontend",
  "main": "worker.js",
  "compatibility_date": "2026-10-10",

  // The Worker answers on the quiz's paths only. The root stays the personal
  // site (GitHub Pages) and /quiz/api/* stays the Python Worker.
  "workers_dev": false,
  "routes": [
    // `quiz*`, not `quiz` + `quiz/*`: a route matches the whole URL including
    // the query string and a pattern cannot hold one, so only a trailing `*`
    // catches /quiz?x=1. It also catches /quizzes, /quiz.html and the like;
    // worker.js hands every path that is not /quiz or /quiz/... back to the
    // origin unchanged. /quiz/api/* (backend) is more specific and still wins.
    { "pattern": "akshayprabhakant.com/quiz*", "zone_name": "akshayprabhakant.com" }
    // No /_next/* route: basePath keeps the chunks under /quiz/_next/.
  ],

  // The Next.js static export (produced by `npm run build`). `run_worker_first`
  // so the /quiz prefix is always stripped before the assets lookup.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // The shared site parts (the theme and the site path): every HTML page goes through
  // site-shell's compose() (akshayDev17/site-themes, shell/). site-shell must
  // be deployed before this binding is, or this deploy fails. worker.js fails
  // open: if site-shell is down, the page is served exactly as built.
  "services": [{ "binding": "SHELL", "service": "site-shell" }]
}
