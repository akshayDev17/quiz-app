{
	"$schema": "../frontend/node_modules/wrangler/config-schema.json",
	"name": "quiz-app-backend",
	"main": "entry.py",
	// Python Workers require this flag:
	// https://developers.cloudflare.com/workers/languages/python/
	"compatibility_flags": [
		"python_workers"
	],
	"compatibility_date": "2026-10-08",
	// Reachable only through the custom domain. Attaching a route flips this to
	// false by default, but it is set explicitly so the intent is not left to an
	// inference.
	"workers_dev": false,
	"routes": [
		{
			"pattern": "akshayprabhakant.com/quiz/api/*",
			"zone_name": "akshayprabhakant.com"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "quiz-app",
			"database_id": "b58fdf0b-bf8e-4613-a136-8089c68aed77"
		},
		{
			"binding": "quiz_app",
			"database_name": "quiz-app",
			"database_id": "b58fdf0b-bf8e-4613-a136-8089c68aed77"
		}
	],
	// Secrets, never "vars": each is set by the owner with `wrangler secret put NAME`
	// and never lands in the repo or in GitHub (docs/deploy.md §C).
	//   ADMIN_EMAILS (comma-separated, case-insensitive): read as
	//     `self.env.ADMIN_EMAILS`; a missing value means no admins.
	//   The AI evaluators of written answers (ADR 0010), each provider usable only
	//   when all of its secrets are set: ANTHROPIC_API_KEY; BEDROCK_API_KEY and
	//   BEDROCK_REGION; AZURE_FOUNDRY_API_KEY and AZURE_FOUNDRY_ENDPOINT.
	// "vars" holds only these non-secret settings: the daily evaluation limits (model
	// calls, one per attempt, per UTC day). Change them here and deploy.
	"vars": {
		"EVAL_USER_DAILY_LIMIT": "20",
		"EVAL_GLOBAL_DAILY_LIMIT": "300"
	},
	// Lets `wrangler dev` simulate an authenticated Access identity, so
	// CloudflareAccessIdentity can be exercised locally without a login flow.
	// The entrypoint reads `ctx.access.getIdentity().email`; this block is what
	// feeds it in dev.
	// https://developers.cloudflare.com/workers/configuration/cloudflare-access/
	"access": {
		"dev": {
			"aud": "quiz-app",
			"identity": {
				"email": "you@example.com"
			}
		}
	}
}